<?xml version="1.0" encoding="UTF-8"?>
<openerp>
    <data>

        <record model="ir.ui.view" id="bill_all_graph_view">
                <field name="name">Bill Register Graph</field>
                <field name="model">bill.register</field>
                <field name="arch" type="xml">
                    <graph string="">
                        <field name="state"/>

                    </graph>
                </field>
        </record>



        <record id="investigation_action_all" model="ir.actions.act_window">
            <field name="name">Bill Register</field>
            <field name="res_model">bill.register</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form,graph</field>
            <field name="context">{}</field>
        </record>

        <!-- expense type tree -->
        <record model="ir.ui.view" id="investigation_all_tree" >
            <field name="name">leih</field>
            <field name="model">bill.register</field>
            <field name="arch" type="xml">
                <tree string="Alu List">
                    <field name="name"/>
                    <field name="date"/>
                    <field name="patient_name"/>
                    <field name="mobile"/>
                    <field name="grand_total" sum="total"/>
                    <field name="paid"/>
                    <field name="due"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>


<!--        <menuitem name="Doctors" id="leih_doctors_menu" parent="leih_menu"/>-->
        <menuitem name="Investigation All" id="investigation_menu_all_mainform" parent="leih_billing_menu" action="investigation_action_all" groups="leih.group_emergency_menu_released"/>

        <template id="assets_backends" name="bill_team assets" inherit_id="web.assets_backend">
            <xpath expr="." position="inside">
                <script type="text/javascript" src="/leih/static/assets/js/example.js"></script>
            </xpath>
        </template>
    </data>
</openerp>
